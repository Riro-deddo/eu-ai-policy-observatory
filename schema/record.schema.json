{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eu-ai-policy-observatory.example/schema/record.schema.json",
  "title": "EU AI Policy Observatory canonical record",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/policy" },
    { "$ref": "#/$defs/document" },
    { "$ref": "#/$defs/event" },
    { "$ref": "#/$defs/concept" },
    { "$ref": "#/$defs/institution" },
    { "$ref": "#/$defs/relationship" },
    { "$ref": "#/$defs/source" }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "common_envelope": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "entity_type": { "type": "string" },
        "publication_status": {
          "enum": ["draft", "pending_review", "verified", "published"]
        },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "updated_at": { "$ref": "#/$defs/timestamp" }
      },
      "required": ["id", "entity_type", "publication_status", "created_at", "updated_at"]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:[0-9]{4}-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8])))|(?:(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:0[48]|[2468][048]|[13579][26])00)-02-29))$"
    },
    "nullable_string": {
      "type": ["string", "null"]
    },
    "http_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "id_list": {
      "type": "array",
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true
    },
    "retained_route_evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_id": { "$ref": "#/$defs/id" },
        "locator": { "type": "string", "minLength": 1 }
      },
      "required": ["source_id", "locator"]
    },
    "retained_route_notice": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": { "const": "parent_relationship_under_review" },
        "reason": { "type": "string", "minLength": 1 },
        "reviewed_by": { "type": "string", "minLength": 1 },
        "reviewed_at": { "$ref": "#/$defs/timestamp" },
        "evidence": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/retained_route_evidence" }
        }
      },
      "required": ["status", "reason", "reviewed_by", "reviewed_at", "evidence"]
    },
    "policy": {
      "allOf": [
        { "$ref": "#/$defs/common_envelope" },
        {
          "type": "object",
          "properties": {
            "entity_type": { "const": "policy" },
            "name": { "type": "string", "minLength": 1 },
            "short_name": { "type": "string", "minLength": 1 },
            "summary": { "type": "string" },
            "policy_family": { "type": "string" },
            "policy_status": { "enum": ["active", "completed", "withdrawn", "superseded"] },
            "scope_note": { "type": "string" }
          },
          "required": ["name", "short_name", "summary", "policy_family", "policy_status", "scope_note"]
        }
      ]
    },
    "document": {
      "allOf": [
        { "$ref": "#/$defs/common_envelope" },
        {
          "type": "object",
          "properties": {
            "entity_type": { "const": "document" },
            "slug": { "$ref": "#/$defs/id" },
            "official_title": { "type": "string", "minLength": 1 },
            "short_title": { "type": "string", "minLength": 1 },
            "document_type": { "enum": ["communication", "coordinated_plan", "expert_guidelines", "white_paper", "legislative_proposal", "regulation", "staff_working_document", "institutional_position", "opinion", "resolution", "decision", "implementing_regulation", "guidelines", "code_of_practice", "template", "report", "standardisation_request", "study", "consultation_document", "declaration", "recommendation", "judgment", "briefing", "technical_specification", "work_programme", "directive", "conclusions"] },
            "sector_tags": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "general_cross_sector", "health", "employment_and_labour",
                  "migration_asylum_and_border_management", "financial_services",
                  "transport_and_mobility", "defence_and_security", "law_enforcement",
                  "justice", "education", "public_administration", "consumer_protection",
                  "media_and_culture", "intellectual_property", "research_and_innovation",
                  "industry_and_manufacturing", "agriculture_and_environment",
                  "critical_infrastructure", "cybersecurity", "competition_and_markets"
                ]
              }
            },
            "provenance_tags": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "eu_institution_authored", "eu_agency_or_body_authored",
                  "eu_expert_group_authored", "eu_commissioned_external",
                  "joint_institutional", "official_consultation_material",
                  "officially_published"
                ]
              }
            },
            "record_level": { "enum": ["principal", "supporting", "version", "attachment"] },
            "official_reference": { "$ref": "#/$defs/nullable_string" },
            "procedure_references": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "oj_reference": { "$ref": "#/$defs/nullable_string" },
            "document_date": { "$ref": "#/$defs/date" },
            "version_label": { "$ref": "#/$defs/nullable_string" },
            "version_status": { "enum": ["draft", "revised", "final", "consolidated", "not_applicable"] },
            "publication_date": { "$ref": "#/$defs/date" },
            "legal_status": { "enum": ["non_binding", "proposed", "adopted", "in_force", "withdrawn", "superseded", "no_longer_in_force", "repealed", "expired"] },
            "celex": { "$ref": "#/$defs/nullable_string" },
            "eli": { "$ref": "#/$defs/nullable_string" },
            "language": { "const": "en" },
            "official_summary": { "$ref": "#/$defs/nullable_string" },
            "institution_roles": {
              "type": "array",
              "items": { "$ref": "#/$defs/institution_role" },
              "uniqueItems": true
            },
            "policy_ids": { "$ref": "#/$defs/id_list" },
            "concept_ids": { "$ref": "#/$defs/id_list" },
            "source_ids": { "$ref": "#/$defs/id_list" },
            "retained_route_notice": { "$ref": "#/$defs/retained_route_notice" },
            "corpus_assessment": { "$ref": "#/$defs/corpus_assessment" },
            "historical_review_status": { "enum": ["verified", "legacy_review_pending"] },
            "temporal_collection": { "enum": ["historical_lineage", "contemporary_eu_ai_policy"] },
            "relevance_class": { "enum": ["direct_ai_substantive", "ai_related_precursor", "indirect_adm_legal_context"] },
            "document_date_kind": { "enum": ["official_act_date", "institutional_adoption", "document_issue", "publication", "consolidation"] },
            "date_evidence": { "$ref": "#/$defs/historical_date_evidence" },
            "classification_evidence": { "type": "array", "items": { "$ref": "#/$defs/classification_evidence_item" } },
            "bibliographic_authors": { "type": "array", "items": { "$ref": "#/$defs/bibliographic_author" } },
            "additional_dates": { "type": "array", "items": { "$ref": "#/$defs/additional_date" } },
            "legal_status_evidence": { "$ref": "#/$defs/historical_citation" },
            "snapshots": {
              "type": "array",
              "items": { "$ref": "#/$defs/snapshot" },
              "uniqueItems": true
            }
          },
          "required": [
            "slug",
            "official_title",
            "short_title",
            "document_type",
            "sector_tags",
            "provenance_tags",
            "record_level",
            "official_reference",
            "procedure_references",
            "oj_reference",
            "document_date",
            "version_label",
            "version_status",
            "publication_date",
            "legal_status",
            "language",
            "institution_roles",
            "policy_ids",
            "concept_ids",
            "source_ids",
            "corpus_assessment"
          ]
        }
      ]
    },
    "event": {
      "allOf": [
        { "$ref": "#/$defs/common_envelope" },
        {
          "type": "object",
          "properties": {
            "entity_type": { "const": "event" },
            "event_type": { "enum": ["proposal", "publication", "adoption", "entry_into_force", "application", "amendment", "withdrawal", "implementation"] },
            "event_date": { "$ref": "#/$defs/date" },
            "title": { "type": "string", "minLength": 1 },
            "description": { "type": "string" },
            "policy_id": { "$ref": "#/$defs/id" },
            "document_id": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
            "source_id": { "$ref": "#/$defs/id" }
          },
          "required": ["event_type", "event_date", "title", "description", "policy_id", "document_id", "source_id"]
        }
      ]
    },
    "concept": {
      "allOf": [
        { "$ref": "#/$defs/common_envelope" },
        {
          "type": "object",
          "properties": {
            "entity_type": { "const": "concept" },
            "name": { "type": "string", "minLength": 1 },
            "definition": { "type": "string" },
            "research_scope": { "type": "string" },
            "eurovoc_uri": { "anyOf": [{ "type": "string", "format": "uri" }, { "type": "null" }] },
            "notes": { "type": "string" }
          },
          "required": ["name", "definition", "research_scope", "eurovoc_uri", "notes"]
        }
      ]
    },
    "institution": {
      "allOf": [
        { "$ref": "#/$defs/common_envelope" },
        {
          "type": "object",
          "properties": {
            "entity_type": { "const": "institution" },
            "official_name": { "type": "string", "minLength": 1 },
            "short_name": { "type": "string", "minLength": 1 },
            "institution_type": { "type": "string", "minLength": 1 },
            "official_url": { "$ref": "#/$defs/http_url" }
          },
          "required": ["official_name", "short_name", "institution_type", "official_url"]
        }
      ]
    },
    "relationship": {
      "allOf": [
        { "$ref": "#/$defs/common_envelope" },
        {
          "type": "object",
          "properties": {
            "entity_type": { "const": "relationship" },
            "source_entity_type": { "enum": ["policy", "document", "event", "concept", "institution", "relationship", "source"] },
            "source_entity_id": { "$ref": "#/$defs/id" },
            "target_entity_type": { "enum": ["policy", "document", "event", "concept", "institution", "relationship", "source"] },
            "target_entity_id": { "$ref": "#/$defs/id" },
            "relationship_type": { "enum": ["part_of", "precedes", "adopted_as", "replaces", "amends", "implements", "based_on", "related_to", "supersedes", "version_of", "annex_to", "revises", "endorses", "procedural_step_for"] },
            "basis": { "enum": ["official", "analytical"] },
            "rationale": { "$ref": "#/$defs/nullable_string" },
            "evidence_source_id": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
            "verification_status": { "enum": ["unverified", "pending", "verified"] }
          },
          "required": ["source_entity_type", "source_entity_id", "target_entity_type", "target_entity_id", "relationship_type", "basis", "rationale", "evidence_source_id", "verification_status"]
        }
      ]
    },
    "source": {
      "allOf": [
        { "$ref": "#/$defs/common_envelope" },
        {
          "type": "object",
          "properties": {
            "entity_type": { "const": "source" },
            "source_type": { "enum": ["eur_lex", "eli", "commission_webpage", "official_pdf", "publications_office", "council_register", "parliament_register", "official_register", "official_consultation"] },
            "url": { "$ref": "#/$defs/http_url" },
            "publisher": { "type": "string", "minLength": 1 },
            "retrieved_at": { "$ref": "#/$defs/timestamp" },
            "last_verified_at": { "$ref": "#/$defs/timestamp" },
            "verification_note": { "type": "string" }
          },
          "required": ["source_type", "url", "publisher", "retrieved_at", "last_verified_at", "verification_note"]
        }
      ]
    },
    "institution_role": {
      "type": "object",
      "properties": {
        "institution_id": { "$ref": "#/$defs/id" },
        "role": { "enum": ["author", "proposer", "adopter", "publisher", "contributor", "commissioner", "official_host", "responsible_body", "requester", "supervisor", "cover_note_sender"] },
        "evidence_source_id": { "$ref": "#/$defs/id" },
        "evidence_locator": { "type": "string", "minLength": 1 }
      },
      "required": ["institution_id", "role"],
      "additionalProperties": false
    },
    "historical_citation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_id": { "$ref": "#/$defs/id" },
        "locator": { "type": "string", "minLength": 1 },
        "meaning": { "type": "string", "minLength": 1 }
      },
      "required": ["source_id", "locator", "meaning"]
    },
    "historical_date_evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "document_date": { "$ref": "#/$defs/historical_citation" },
        "publication_date": { "$ref": "#/$defs/historical_citation" }
      },
      "required": ["document_date", "publication_date"]
    },
    "classification_evidence_item": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "field": { "enum": ["relevance_class", "sector_tags", "provenance_tags"] },
        "value": { "type": "string", "minLength": 1 },
        "source_id": { "$ref": "#/$defs/id" },
        "locator": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 }
      },
      "required": ["field", "value", "source_id", "locator", "rationale"]
    },
    "bibliographic_author": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "affiliation": { "$ref": "#/$defs/nullable_string" },
        "evidence_source_id": { "$ref": "#/$defs/id" },
        "evidence_locator": { "type": "string", "minLength": 1 }
      },
      "required": ["name", "affiliation", "evidence_source_id", "evidence_locator"]
    },
    "additional_date": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["document_issue", "institutional_adoption", "first_official_publication", "oj_publication", "manuscript_completion", "cover_issue", "consolidation", "official_end_of_validity", "official_dispatch", "parliament_adopted_text_manifestation"] },
        "value": { "type": "string", "pattern": "^[0-9]{4}(?:-[0-9]{2}(?:-[0-9]{2})?)?$" },
        "precision": { "enum": ["day", "month", "year"] },
        "source_id": { "$ref": "#/$defs/id" },
        "locator": { "type": "string", "minLength": 1 }
      },
      "required": ["kind", "value", "precision", "source_id", "locator"]
    },
    "corpus_assessment": {
      "type": "object",
      "properties": {
        "corpus_tier": { "enum": ["core", "directly_related", "contextual", "excluded"] },
        "policy_stage": { "enum": ["agenda_setting", "coordination", "consultation", "proposal", "negotiation", "adoption", "implementation"] },
        "inclusion_rationale": { "type": "string" },
        "researcher_notes": { "type": "string" },
        "review_status": { "enum": ["unverified", "pending", "verified"] },
        "reviewed_by": { "type": "string", "minLength": 1 },
        "reviewed_at": { "$ref": "#/$defs/timestamp" }
      },
      "required": ["corpus_tier", "policy_stage", "inclusion_rationale", "researcher_notes", "review_status", "reviewed_by", "reviewed_at"],
      "additionalProperties": false
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "source_id": { "$ref": "#/$defs/id" },
        "retrieved_at": { "$ref": "#/$defs/timestamp" },
        "format": { "type": "string", "minLength": 1 },
        "content_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "archived_path": { "$ref": "#/$defs/nullable_string" }
      },
      "required": ["id", "source_id", "retrieved_at", "format", "content_hash", "archived_path"],
      "additionalProperties": false
    }
  }
}
