{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eu-ai-policy-observatory.example/schema/corpus-inventory.schema.json",
  "title": "EU AI Policy Observatory corpus inventory",
  "type": "object",
  "properties": {
    "generated_at": { "$ref": "#/$defs/timestamp" },
    "candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidate" }
    }
  },
  "required": ["generated_at", "candidates"],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "nullable_id": {
      "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }]
    },
    "nullable_string": {
      "type": ["string", "null"]
    },
    "nullable_timestamp": {
      "type": ["string", "null"],
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "https_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "candidate": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "source_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "minItems": 1,
          "uniqueItems": true
        },
        "official_reference": { "$ref": "#/$defs/nullable_string" },
        "official_title": { "type": "string", "minLength": 1 },
        "year": { "type": "integer", "minimum": 1, "maximum": 9999 },
        "issuing_institution": { "type": "string", "minLength": 1 },
        "record_level": {
          "enum": ["principal", "supporting", "version", "attachment"]
        },
        "version_label": { "$ref": "#/$defs/nullable_string" },
        "official_source_url": { "$ref": "#/$defs/https_url" },
        "commissioning_body": { "$ref": "#/$defs/nullable_string" },
        "candidate_provenance": { "type": "string", "minLength": 1 },
        "provisional_sector_tags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "discovered_at": { "$ref": "#/$defs/timestamp" },
        "decision": {
          "enum": ["included", "merged", "excluded", "pending"]
        },
        "decision_reason": { "type": "string", "minLength": 1 },
        "document_id": { "$ref": "#/$defs/nullable_id" },
        "merged_into_document_id": { "$ref": "#/$defs/nullable_id" },
        "reviewed_at": { "$ref": "#/$defs/nullable_timestamp" },
        "reviewed_by": { "$ref": "#/$defs/nullable_string" },
        "decision_history": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "decision": { "enum": ["included", "merged", "excluded", "pending"] },
              "decision_reason": { "type": "string", "minLength": 1 },
              "document_id": { "$ref": "#/$defs/nullable_id" },
              "merged_into_document_id": { "$ref": "#/$defs/nullable_id" },
              "reviewed_at": { "$ref": "#/$defs/nullable_timestamp" },
              "reviewed_by": { "$ref": "#/$defs/nullable_string" }
            },
            "required": ["decision", "decision_reason", "document_id", "merged_into_document_id", "reviewed_at", "reviewed_by"],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "source_ids",
        "official_reference",
        "official_title",
        "year",
        "issuing_institution",
        "record_level",
        "version_label",
        "official_source_url",
        "commissioning_body",
        "candidate_provenance",
        "provisional_sector_tags",
        "discovered_at",
        "decision",
        "decision_reason",
        "document_id",
        "merged_into_document_id",
        "reviewed_at",
        "reviewed_by"
      ],
      "additionalProperties": false
    }
  }
}
