---
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadPublicData } from '../lib/data';

const data = loadPublicData();
---

<BaseLayout
  title="About | EU AI Policy Observatory"
  description="About the EU AI Policy Observatory and its current research scope."
  canonicalPath="/about/"
>
  <article class="editorial-page">
    <header class="editorial-page__header">
      <p class="section-kicker">About</p>
      <h1>EU AI Policy Observatory</h1>
      <p>
        A static research atlas for examining published European Union artificial intelligence
        policy records, their documented relationships and their provenance.
      </p>
    </header>

    <section aria-labelledby="scope">
      <h2 id="scope">Current scope</h2>
      <p>
        The database is the primary research output; this atlas presents its published records.
        The current collection is concentrated on the AI Act pathway and related implementation,
        within an expanding research scope that also admits earlier European Communities and EU
        AI-related documents. The published database currently spans
        {data.coverage.from_year}–{data.coverage.to_year}, with
        {data.coverage.principal_documents} principal documents and
        {data.coverage.supporting_files_and_versions} supporting files and versions.
      </p>
    </section>

    <section aria-labelledby="limitations">
      <h2 id="limitations">Limitations</h2>
      <p>
        The Observatory is a read-only view of a selected corpus. It does not replace official
        legal sources, provide legal advice, reproduce a full policy archive or implement the
        planned LLM comparison.
      </p>
    </section>

    <section aria-labelledby="authorship">
      <h2 id="authorship">Authorship</h2>
      <p><span>Created and maintained by Yichen Hao</span>.</p>
    </section>
  </article>
</BaseLayout>
