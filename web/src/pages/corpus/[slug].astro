---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RetainedRouteNotice from '../../components/RetainedRouteNotice.astro';
import { loadPublicData } from '../../lib/data';
import { documentTypeLabel, groupDocumentRelationships, vocabularyLabel } from '../../lib/filter';
import { relationshipTypeLabel } from '../../lib/policy-map';
import type { DocumentRecord, PublicData, Relationship } from '../../lib/types';

interface Props {
  data: PublicData;
  document: DocumentRecord;
}

export function getStaticPaths() {
  const data = loadPublicData();
  return data.documents.map((document) => ({
    params: { slug: document.slug },
    props: { data, document },
  }));
}

const { data, document }: Props = Astro.props;
const base = import.meta.env.BASE_URL;
const documentsById = new Map(data.documents.map((entry) => [entry.id, entry]));

const labels = new Map<string, string>();
for (const policy of data.policies) labels.set(`policy:${policy.id}`, policy.short_name);
for (const entry of data.documents) labels.set(`document:${entry.id}`, entry.short_title);
for (const event of data.events) labels.set(`event:${event.id}`, event.title);
for (const concept of data.concepts) labels.set(`concept:${concept.id}`, concept.name);
for (const institution of data.institutions) labels.set(`institution:${institution.id}`, institution.official_name);
for (const source of data.sources) labels.set(`source:${source.id}`, source.publisher);

const readableLabel = (entityType: string, entityId: string) => labels.get(`${entityType}:${entityId}`) ?? entityId;
const sourceById = new Map(data.sources.map((source) => [source.id, source]));
const officialSources = document.sources.filter((source) => source.source_type !== 'institutional_archive');
const supplementarySources = document.sources.filter((source) => source.source_type === 'institutional_archive');
const assessment = document.corpus_assessment;
const qualification = document.review_qualification;
const qualificationLabels = {
  parent_evidence_pending: 'Original text and publication confirmed; parent evidence pending',
  publication_date_pending: 'Official text and adoption confirmed; publication date pending',
  official_version_conflict: 'Official version information conflicts',
};
const relationshipBasisLabel = (relationship: Relationship) => (
  relationship.basis === 'analytical' ? 'Analytical relationship' : 'Official relationship'
);
const entityHref = (entityType: string, entityId: string): string | undefined => {
  if (entityType === 'document') {
    const relatedDocument = documentsById.get(entityId);
    return relatedDocument === undefined ? undefined : `${base}corpus/${relatedDocument.slug}/`;
  }
  if (entityType === 'policy') return `${base}policies/${entityId}/`;
  return undefined;
};
const relationshipGroups = groupDocumentRelationships(document, data.documents, data.relationships);
const parentRelationships = relationshipGroups.parent;
const attachmentRelationships = relationshipGroups.attachments;
const versionRelationships = relationshipGroups.versions;
const otherRelationships = relationshipGroups.other;
const hasOfficialIdentifiers = [document.celex, document.eli, document.oj_reference].some((value) => value !== null);
---

<BaseLayout
  title={`${document.short_title} | EU AI Policy Observatory`}
  description={`Published record for ${document.short_title}.`}
  canonicalPath={`/corpus/${document.slug}/`}
>
  <article class="research-section document-record">
    <p class="section-kicker">Published document record</p>
    <h1>{document.short_title}</h1>
    {document.retained_route_notice !== null && (
      <RetainedRouteNotice
        notice={document.retained_route_notice}
        sources={document.sources}
      />
    )}
    {qualification && <aside aria-labelledby="qualified-evidence-review">
      <h2 id="qualified-evidence-review">{qualificationLabels[qualification.kind]}</h2>
      <p>{qualification.confirmed}</p>
      <p>{qualification.unresolved}</p>
      <p>This is a qualified evidence assessment, not a completed expanded verification.</p>
    </aside>}
    {!qualification && document.historical_review_status === 'legacy_review_pending' && (
      <aside aria-labelledby="expanded-evidence-review-pending">
        <h2 id="expanded-evidence-review-pending">Expanded evidence review pending</h2>
        <p>
          This retained official record remains published under its existing checks. Its expanded
          date, attribution and historical relevance evidence has not yet been completed, so no
          temporal collection or relevance class is inferred here.
        </p>
      </aside>
    )}

    <section aria-labelledby="official-metadata">
      <h2 id="official-metadata">Official metadata</h2>
      <dl>
        <dt>Official title</dt><dd>{document.official_title}</dd>
        {document.official_reference !== null && <><dt>Official reference</dt><dd>{document.official_reference}</dd></>}
        <dt>Document type</dt><dd>{documentTypeLabel(document.document_type)}</dd>
        <dt>Document date</dt><dd>{document.document_date}</dd>
        <dt>Document date kind</dt><dd>{document.document_date_kind === null ? 'Expanded evidence review pending' : vocabularyLabel(document.document_date_kind)}</dd>
        {document.date_evidence !== null && (() => {
          const evidenceSource = sourceById.get(document.date_evidence.document_date.source_id);
          return <><dt>Document-date evidence</dt><dd>
            {evidenceSource === undefined ? document.date_evidence.document_date.source_id : <a href={evidenceSource.url}>{evidenceSource.publisher}</a>}
            {' · '}{document.date_evidence.document_date.locator} — {document.date_evidence.document_date.meaning}
          </dd></>;
        })()}
        <dt>Publication date</dt><dd>{document.publication_date ?? 'Publication date not yet confirmed'}</dd>
        {document.date_evidence !== null && (() => {
          const evidenceSource = sourceById.get(document.date_evidence.publication_date.source_id);
          return <><dt>Publication-date evidence</dt><dd>
            {evidenceSource === undefined ? document.date_evidence.publication_date.source_id : <a href={evidenceSource.url}>{evidenceSource.publisher}</a>}
            {' · '}{document.date_evidence.publication_date.locator} — {document.date_evidence.publication_date.meaning}
          </dd></>;
        })()}
        {document.additional_dates.length > 0 && <><dt>Additional official dates</dt><dd><ul>
          {document.additional_dates.map((date) => {
            const evidenceSource = sourceById.get(date.source_id);
            return <li>{vocabularyLabel(date.kind)}: {date.value} ({date.precision}) · {evidenceSource === undefined ? date.source_id : <a href={evidenceSource.url}>{evidenceSource.publisher}</a>} · {date.locator}</li>;
          })}
        </ul></dd></>}
        {document.version_label !== null && <><dt>Version label</dt><dd>{document.version_label}</dd></>}
        <dt>Legal status</dt><dd>{vocabularyLabel(document.legal_status)}</dd>
        {document.legal_status_evidence !== null && (() => {
          const evidenceSource = sourceById.get(document.legal_status_evidence.source_id);
          return <><dt>Legal-status evidence</dt><dd>{evidenceSource === undefined ? document.legal_status_evidence.source_id : <a href={evidenceSource.url}>{evidenceSource.publisher}</a>} · {document.legal_status_evidence.locator} — {document.legal_status_evidence.meaning}</dd></>;
        })()}
        <dt>Language</dt><dd>{document.language}</dd>
        {document.official_summary !== null && <><dt>Official summary</dt><dd>{document.official_summary}</dd></>}
      </dl>
    </section>

    <section aria-labelledby="research-classifications">
      <h2 id="research-classifications">Research classifications</h2>
      <p>These are researcher classifications used to organise and analyse the corpus; they are not official EU metadata.</p>
      <dl>
        <dt>Record level</dt><dd>{vocabularyLabel(document.record_level)}</dd>
        <dt>Version status</dt><dd>{vocabularyLabel(document.version_status)}</dd>
        <dt>Temporal collection</dt><dd>{vocabularyLabel(document.temporal_collection ?? document.historical_review_status)}</dd>
        <dt>Relevance class</dt><dd>{vocabularyLabel(document.relevance_class ?? document.historical_review_status)}</dd>
        <dt>Policy stage</dt><dd>{assessment === null ? 'Not assigned' : vocabularyLabel(assessment.policy_stage)}</dd>
        <dt>Corpus tier</dt><dd>{assessment === null ? 'Not assigned' : vocabularyLabel(assessment.corpus_tier)}</dd>
        <dt>Sectors</dt>
        <dd>{document.sector_tags.length === 0 ? 'Not assigned' : <ul class="tag-list">{document.sector_tags.map((sector) => <li>{vocabularyLabel(sector)}</li>)}</ul>}</dd>
        <dt>Policy membership</dt>
        <dd><ul class="tag-list">{document.policies.map((policy) => <li>{policy.short_name}</li>)}</ul></dd>
        <dt>Research concepts</dt>
        <dd><ul class="tag-list">{document.concepts.map((concept) => <li>{concept.name}</li>)}</ul></dd>
      </dl>
      {document.classification_evidence.length > 0 && <>
        <h3>Classification evidence</h3>
        <ul>
          {document.classification_evidence.map((evidence) => {
            const evidenceSource = sourceById.get(evidence.source_id);
            return <li><strong>{vocabularyLabel(evidence.field)}: {vocabularyLabel(evidence.value)}</strong> · {evidenceSource === undefined ? evidence.source_id : <a href={evidenceSource.url}>{evidenceSource.publisher}</a>} · {evidence.locator} — {evidence.rationale}</li>;
          })}
        </ul>
      </>}
    </section>

    <section aria-labelledby="production-provenance">
      <h2 id="production-provenance">Production provenance</h2>
      <dl>
        <dt>Provenance tags</dt>
        <dd>{document.provenance_tags.length === 0 ? 'Not assigned' : <ul class="tag-list">{document.provenance_tags.map((provenance) => <li>{vocabularyLabel(provenance)}</li>)}</ul>}</dd>
        <dt>Named bibliographic authors</dt>
        <dd>{document.bibliographic_authors.length === 0
          ? document.historical_review_status === 'legacy_review_pending' ? 'Expanded evidence review pending' : 'None recorded after review'
          : <ul>
          {document.bibliographic_authors.map((author) => {
            const evidenceSource = sourceById.get(author.evidence_source_id);
            return <li>{author.name}{author.affiliation === null ? '' : ` · ${author.affiliation}`} · {evidenceSource === undefined ? author.evidence_source_id : <a href={evidenceSource.url}>{evidenceSource.publisher}</a>} · {author.evidence_locator}</li>;
          })}
        </ul>}</dd>
        <dt>Institutions and roles</dt>
        <dd>
          <ul>
            {document.institutions.map((institution) => (
              <li>
                <a href={institution.official_url}>{institution.official_name}</a> · {vocabularyLabel(institution.role)}
                {institution.evidence_source_id !== null && (() => {
                  const evidenceSource = sourceById.get(institution.evidence_source_id);
                  return <> · {evidenceSource === undefined ? institution.evidence_source_id : <a href={evidenceSource.url}>role evidence</a>}{institution.evidence_locator === null ? '' : ` · ${institution.evidence_locator}`}</>;
                })()}
              </li>
            ))}
          </ul>
        </dd>
      </dl>
    </section>

    <section aria-labelledby="official-sources-and-identifiers">
      <h2 id="official-sources-and-identifiers">Official sources and identifiers</h2>
      {hasOfficialIdentifiers && (
        <dl>
          {document.celex !== null && <><dt>CELEX</dt><dd>{document.celex}</dd></>}
          {document.eli !== null && <><dt>ELI</dt><dd>{document.eli}</dd></>}
          {document.oj_reference !== null && <><dt>OJ reference</dt><dd>{document.oj_reference}</dd></>}
        </dl>
      )}
      <ul>
        {officialSources.map((source) => (
          <li><a href={source.url}>Official source</a> · Publisher/host: {source.publisher}</li>
        ))}
      </ul>
    </section>

    {supplementarySources.length > 0 && (
      <section aria-labelledby="supplementary-preserved-originals">
        <h2 id="supplementary-preserved-originals">Supplementary preserved originals</h2>
        <p>These academy-hosted copies preserve the original edition. They are supplementary evidence, not official EU hosts, and are used together with the official release record above.</p>
        <ul>
          {supplementarySources.map((source) => (
            <li>
              <a href={source.url}>Preserved original: {source.publisher}</a>
              <p>{source.verification_note}</p>
            </li>
          ))}
        </ul>
      </section>
    )}

    {document.procedure_references.length > 0 && (
      <section aria-labelledby="formal-procedure">
        <h2 id="formal-procedure">Formal procedure</h2>
        <p>Official procedure reference{document.procedure_references.length === 1 ? '' : 's'}:</p>
        <ul>{document.procedure_references.map((reference) => <li>{reference}</li>)}</ul>
      </section>
    )}

    {parentRelationships.length > 0 && (
      <section aria-labelledby="parent-or-principal-record">
        <h2 id="parent-or-principal-record">Parent or principal record</h2>
        <ul>
          {parentRelationships.map(({ relationship, relatedDocument, contextLabel }) => (
            <li>
              <p>{contextLabel}: <a href={`${base}corpus/${relatedDocument.slug}/`}>{relatedDocument.short_title}</a></p>
              <p>{relationshipTypeLabel(relationship.relationship_type)} · {relationshipBasisLabel(relationship)} · {vocabularyLabel(relationship.verification_status)}</p>
            </li>
          ))}
        </ul>
      </section>
    )}

    {attachmentRelationships.length > 0 && (
      <section aria-labelledby="attachments">
        <h2 id="attachments">Attachments</h2>
        <ul>
          {attachmentRelationships.map(({ relationship, relatedDocument, contextLabel }) => (
            <li>
              <p>{contextLabel}: <a href={`${base}corpus/${relatedDocument.slug}/`}>{relatedDocument.short_title}</a></p>
              <p>{relationshipTypeLabel(relationship.relationship_type)} · {relationshipBasisLabel(relationship)} · {vocabularyLabel(relationship.verification_status)}</p>
            </li>
          ))}
        </ul>
      </section>
    )}

    {versionRelationships.length > 0 && (
      <section aria-labelledby="previous-and-next-versions">
        <h2 id="previous-and-next-versions">Previous and next versions</h2>
        <ul>
          {versionRelationships.map(({ relationship, relatedDocument, contextLabel }) => (
            <li>
              <p>{contextLabel}: <a href={`${base}corpus/${relatedDocument.slug}/`}>{relatedDocument.short_title}</a></p>
              <p>{relationshipTypeLabel(relationship.relationship_type)} · {relationshipBasisLabel(relationship)} · {vocabularyLabel(relationship.verification_status)}</p>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section aria-labelledby="research-assessment">
      <h2 id="research-assessment">Research assessment</h2>
      {assessment === null ? (
        <p>No research assessment has been published for this record.</p>
      ) : (
        <dl>
          <dt>Inclusion rationale</dt><dd>{assessment.inclusion_rationale}</dd>
          <dt>Researcher notes</dt><dd>{assessment.researcher_notes}</dd>
          <dt>Review status</dt><dd>{assessment.review_status}</dd>
        </dl>
      )}
    </section>

    <section aria-labelledby="relationships">
      <h2 id="relationships">Relationships</h2>
      {otherRelationships.length === 0 ? <p>No additional published relationships touch this record.</p> : (
        <ul>
          {otherRelationships.map((relationship) => {
            const evidence = relationship.evidence_source_id === null
              ? undefined
              : sourceById.get(relationship.evidence_source_id);
            const sourceHref = entityHref(relationship.source_entity_type, relationship.source_entity_id);
            const targetHref = entityHref(relationship.target_entity_type, relationship.target_entity_id);
            return (
              <li>
                <p>
                  {sourceHref === undefined
                    ? readableLabel(relationship.source_entity_type, relationship.source_entity_id)
                    : <a href={sourceHref}>{readableLabel(relationship.source_entity_type, relationship.source_entity_id)}</a>}
                  {' · '}{relationshipTypeLabel(relationship.relationship_type)}{' · '}
                  {targetHref === undefined
                    ? readableLabel(relationship.target_entity_type, relationship.target_entity_id)
                    : <a href={targetHref}>{readableLabel(relationship.target_entity_type, relationship.target_entity_id)}</a>}
                </p>
                <p>{relationshipBasisLabel(relationship)} · {vocabularyLabel(relationship.verification_status)}</p>
                {relationship.rationale !== null && <p>{relationship.basis === 'analytical' ? 'Research assessment rationale: ' : 'Official rationale: '}{relationship.rationale}</p>}
                {evidence !== undefined && <p><a href={evidence.url}>Evidence source: {evidence.publisher}</a></p>}
              </li>
            );
          })}
        </ul>
      )}
    </section>

    <section aria-labelledby="verification">
      <h2 id="verification">Verification</h2>
      <dl>
        <dt>Expanded evidence review</dt><dd>{vocabularyLabel(document.historical_review_status)}</dd>
        {qualification && <>
          <dt>Confirmed evidence</dt><dd>{qualification.confirmed}</dd>
          <dt>Remaining qualification</dt><dd>{qualification.unresolved}</dd>
        </>}
      </dl>
      {assessment === null ? <p>Research assessment verification has not been assigned.</p> : (
        <dl>
          <dt>Reviewed by</dt><dd>Yichen Hao</dd>
          <dt>Verification date</dt><dd>{assessment.reviewed_at}</dd>
        </dl>
      )}
      <ul>
        {document.sources.map((source) => <li>Last verified: {source.last_verified_at} · {source.verification_note}</li>)}
      </ul>
    </section>

    <p><a href={`${base}corpus/`}>Return to the Corpus</a></p>
  </article>
</BaseLayout>
