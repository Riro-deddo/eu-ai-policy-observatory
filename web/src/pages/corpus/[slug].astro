---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadPublicData } from '../../lib/data';
import { documentTypeLabel, groupDocumentRelationships, vocabularyLabel } from '../../lib/filter';
import { relationshipTypeLabel } from '../../lib/policy-map';
import type { DocumentRecord, PublicData, Relationship } from '../../lib/types';

interface Props {
  data: PublicData;
  document: DocumentRecord;
}

export function getStaticPaths() {
  const data = loadPublicData();
  return data.documents.map((document) => ({
    params: { slug: document.slug },
    props: { data, document },
  }));
}

const { data, document }: Props = Astro.props;
const base = import.meta.env.BASE_URL;
const documentsById = new Map(data.documents.map((entry) => [entry.id, entry]));

const labels = new Map<string, string>();
for (const policy of data.policies) labels.set(`policy:${policy.id}`, policy.short_name);
for (const entry of data.documents) labels.set(`document:${entry.id}`, entry.short_title);
for (const event of data.events) labels.set(`event:${event.id}`, event.title);
for (const concept of data.concepts) labels.set(`concept:${concept.id}`, concept.name);
for (const institution of data.institutions) labels.set(`institution:${institution.id}`, institution.official_name);
for (const source of data.sources) labels.set(`source:${source.id}`, source.publisher);

const readableLabel = (entityType: string, entityId: string) => labels.get(`${entityType}:${entityId}`) ?? entityId;
const sourceById = new Map(data.sources.map((source) => [source.id, source]));
const assessment = document.corpus_assessment;
const relationshipBasisLabel = (relationship: Relationship) => (
  relationship.basis === 'analytical' ? 'Analytical relationship' : 'Official relationship'
);
const entityHref = (entityType: string, entityId: string): string | undefined => {
  if (entityType === 'document') {
    const relatedDocument = documentsById.get(entityId);
    return relatedDocument === undefined ? undefined : `${base}corpus/${relatedDocument.slug}/`;
  }
  if (entityType === 'policy') return `${base}policies/${entityId}/`;
  return undefined;
};
const relationshipGroups = groupDocumentRelationships(document, data.documents, data.relationships);
const parentRelationships = relationshipGroups.parent;
const attachmentRelationships = relationshipGroups.attachments;
const versionRelationships = relationshipGroups.versions;
const otherRelationships = relationshipGroups.other;
const hasOfficialIdentifiers = [document.celex, document.eli, document.oj_reference].some((value) => value !== null);
---

<BaseLayout
  title={`${document.short_title} | EU AI Policy Observatory`}
  description={`Published record for ${document.short_title}.`}
  canonicalPath={`/corpus/${document.slug}/`}
>
  <article class="research-section document-record">
    <p class="section-kicker">Published document record</p>
    <h1>{document.short_title}</h1>

    <section aria-labelledby="official-metadata">
      <h2 id="official-metadata">Official metadata</h2>
      <dl>
        <dt>Official title</dt><dd>{document.official_title}</dd>
        {document.official_reference !== null && <><dt>Official reference</dt><dd>{document.official_reference}</dd></>}
        <dt>Document type</dt><dd>{documentTypeLabel(document.document_type)}</dd>
        <dt>Document date</dt><dd>{document.document_date}</dd>
        <dt>Publication date</dt><dd>{document.publication_date}</dd>
        <dt>Record level</dt><dd>{vocabularyLabel(document.record_level)}</dd>
        {document.version_label !== null && <><dt>Version label</dt><dd>{document.version_label}</dd></>}
        <dt>Version status</dt><dd>{vocabularyLabel(document.version_status)}</dd>
        <dt>Legal status</dt><dd>{vocabularyLabel(document.legal_status)}</dd>
        <dt>Language</dt><dd>{document.language}</dd>
        {document.official_summary !== null && <><dt>Official summary</dt><dd>{document.official_summary}</dd></>}
      </dl>
    </section>

    <section aria-labelledby="institutions-and-roles">
      <h2 id="institutions-and-roles">Institutions and roles</h2>
      <ul>
        {document.institutions.map((institution) => (
          <li><a href={institution.official_url}>{institution.official_name}</a> · {institution.role}</li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="official-sources-and-identifiers">
      <h2 id="official-sources-and-identifiers">Official sources and identifiers</h2>
      {hasOfficialIdentifiers && (
        <dl>
          {document.celex !== null && <><dt>CELEX</dt><dd>{document.celex}</dd></>}
          {document.eli !== null && <><dt>ELI</dt><dd>{document.eli}</dd></>}
          {document.oj_reference !== null && <><dt>OJ reference</dt><dd>{document.oj_reference}</dd></>}
        </dl>
      )}
      <ul>
        {document.sources.map((source) => (
          <li><a href={source.url}>Source URL: {source.publisher}</a></li>
        ))}
      </ul>
    </section>

    {document.procedure_references.length > 0 && (
      <section aria-labelledby="formal-procedure">
        <h2 id="formal-procedure">Formal procedure</h2>
        <p>Official procedure reference{document.procedure_references.length === 1 ? '' : 's'}:</p>
        <ul>{document.procedure_references.map((reference) => <li>{reference}</li>)}</ul>
      </section>
    )}

    <section aria-labelledby="policy-placement-and-concepts">
      <h2 id="policy-placement-and-concepts">Policy placement and concepts</h2>
      <p><strong>Research assessment:</strong> Policy placement and concepts are researcher classifications.</p>
      <dl>
        <dt>Policy stage</dt><dd>{assessment === null ? 'Not assigned' : vocabularyLabel(assessment.policy_stage)}</dd>
        <dt>Corpus tier</dt><dd>{assessment === null ? 'Not assigned' : vocabularyLabel(assessment.corpus_tier)}</dd>
      </dl>
      <ul>
        {document.policies.map((policy) => <li>{policy.short_name}</li>)}
        {document.concepts.map((concept) => <li>{concept.name}</li>)}
      </ul>
    </section>

    {parentRelationships.length > 0 && (
      <section aria-labelledby="parent-or-principal-record">
        <h2 id="parent-or-principal-record">Parent or principal record</h2>
        <ul>
          {parentRelationships.map(({ relationship, relatedDocument, contextLabel }) => (
            <li>
              <p>{contextLabel}: <a href={`${base}corpus/${relatedDocument.slug}/`}>{relatedDocument.short_title}</a></p>
              <p>{relationshipTypeLabel(relationship.relationship_type)} · {relationshipBasisLabel(relationship)} · {vocabularyLabel(relationship.verification_status)}</p>
            </li>
          ))}
        </ul>
      </section>
    )}

    {attachmentRelationships.length > 0 && (
      <section aria-labelledby="attachments">
        <h2 id="attachments">Attachments</h2>
        <ul>
          {attachmentRelationships.map(({ relationship, relatedDocument, contextLabel }) => (
            <li>
              <p>{contextLabel}: <a href={`${base}corpus/${relatedDocument.slug}/`}>{relatedDocument.short_title}</a></p>
              <p>{relationshipTypeLabel(relationship.relationship_type)} · {relationshipBasisLabel(relationship)} · {vocabularyLabel(relationship.verification_status)}</p>
            </li>
          ))}
        </ul>
      </section>
    )}

    {versionRelationships.length > 0 && (
      <section aria-labelledby="previous-and-next-versions">
        <h2 id="previous-and-next-versions">Previous and next versions</h2>
        <ul>
          {versionRelationships.map(({ relationship, relatedDocument, contextLabel }) => (
            <li>
              <p>{contextLabel}: <a href={`${base}corpus/${relatedDocument.slug}/`}>{relatedDocument.short_title}</a></p>
              <p>{relationshipTypeLabel(relationship.relationship_type)} · {relationshipBasisLabel(relationship)} · {vocabularyLabel(relationship.verification_status)}</p>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section aria-labelledby="research-assessment">
      <h2 id="research-assessment">Research assessment</h2>
      {assessment === null ? (
        <p>No research assessment has been published for this record.</p>
      ) : (
        <dl>
          <dt>Inclusion rationale</dt><dd>{assessment.inclusion_rationale}</dd>
          <dt>Researcher notes</dt><dd>{assessment.researcher_notes}</dd>
          <dt>Review status</dt><dd>{assessment.review_status}</dd>
        </dl>
      )}
    </section>

    <section aria-labelledby="relationships">
      <h2 id="relationships">Relationships</h2>
      {otherRelationships.length === 0 ? <p>No additional published relationships touch this record.</p> : (
        <ul>
          {otherRelationships.map((relationship) => {
            const evidence = relationship.evidence_source_id === null
              ? undefined
              : sourceById.get(relationship.evidence_source_id);
            const sourceHref = entityHref(relationship.source_entity_type, relationship.source_entity_id);
            const targetHref = entityHref(relationship.target_entity_type, relationship.target_entity_id);
            return (
              <li>
                <p>
                  {sourceHref === undefined
                    ? readableLabel(relationship.source_entity_type, relationship.source_entity_id)
                    : <a href={sourceHref}>{readableLabel(relationship.source_entity_type, relationship.source_entity_id)}</a>}
                  {' · '}{relationshipTypeLabel(relationship.relationship_type)}{' · '}
                  {targetHref === undefined
                    ? readableLabel(relationship.target_entity_type, relationship.target_entity_id)
                    : <a href={targetHref}>{readableLabel(relationship.target_entity_type, relationship.target_entity_id)}</a>}
                </p>
                <p>{relationshipBasisLabel(relationship)} · {vocabularyLabel(relationship.verification_status)}</p>
                {relationship.rationale !== null && <p>{relationship.basis === 'analytical' ? 'Research assessment rationale: ' : 'Official rationale: '}{relationship.rationale}</p>}
                {evidence !== undefined && <p><a href={evidence.url}>Evidence source: {evidence.publisher}</a></p>}
              </li>
            );
          })}
        </ul>
      )}
    </section>

    <section aria-labelledby="verification">
      <h2 id="verification">Verification</h2>
      {assessment === null ? <p>Research assessment verification has not been assigned.</p> : (
        <dl>
          <dt>Reviewed by</dt><dd>{assessment.reviewed_by}</dd>
          <dt>Verification date</dt><dd>{assessment.reviewed_at}</dd>
        </dl>
      )}
      <ul>
        {document.sources.map((source) => <li>Last verified: {source.last_verified_at} · {source.verification_note}</li>)}
      </ul>
    </section>

    <p><a href={`${base}corpus/`}>Return to the Corpus</a></p>
  </article>
</BaseLayout>
