---
import BaseLayout from '../layouts/BaseLayout.astro';
import PolicyPathway from '../components/PolicyPathway.astro';
import ResearchLenses from '../components/ResearchLenses.astro';
import { loadPublicData } from '../lib/data';

const data = loadPublicData();
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="EU AI Policy Observatory"
  description="A static research atlas of published European Union artificial intelligence policy records."
  canonicalPath="/"
>
  <section class="hero" aria-labelledby="project-argument">
    <div class="hero__meta">Research database · EU AI Act policy process · English-language records</div>
    <h1 id="project-argument">How EU AI policy is formulated, interpreted and transformed</h1>
    <p class="hero__lede">
      The database serves as research infrastructure; this atlas presents its published records. The expanding collection brings together a bounded, verified historical lineage with contemporary EU AI policy, the AI Act pathway, and related implementation records.
    </p>
  </section>
  <ResearchLenses concepts={data.concepts} />
  <PolicyPathway coverage={data.coverage} documents={data.documents} events={data.events} />
  <section class="research-section atlas-links" aria-labelledby="explore-the-atlas">
    <div class="section-heading">
      <p class="section-kicker">Explore the atlas</p>
      <h2 id="explore-the-atlas">Follow the records and relationships</h2>
    </div>
    <p>
      <a href={`${base}policy-map/`}>View the Policy Map</a>
      <a href={`${base}corpus/`}>Browse the Corpus</a>
    </p>
  </section>
</BaseLayout>
