---
const base = import.meta.env.BASE_URL;
const links = [
  { label: 'Home', href: base },
  { label: 'Policy Map', href: `${base}policy-map/` },
  { label: 'Timeline', href: `${base}timeline/` },
  { label: 'Corpus', href: `${base}corpus/` },
  { label: 'Methodology', href: `${base}methodology/` },
  { label: 'About', href: `${base}about/` },
];
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="wordmark" href={base}>EU AI Policy Observatory</a>
    <nav aria-label="Primary">
      <ul class="primary-nav">
        {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>
    </nav>
  </div>
</header>
