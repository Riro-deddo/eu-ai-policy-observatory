---
import { filterDocuments, vocabularyLabel } from '../lib/filter';
import type { DocumentRecord } from '../lib/types';

interface Props {
  documents: DocumentRecord[];
}

const { documents }: Props = Astro.props;
const base = import.meta.env.BASE_URL;
const sortedDocuments = filterDocuments(documents, { view: 'all' });
const principalCount = documents.filter((document) => document.record_level === 'principal').length;
const supportingCount = documents.length - principalCount;
const pendingPublishedCount = documents.filter(
  (document) => document.historical_review_status === 'legacy_review_pending',
).length;

const years = [...new Set(documents.flatMap((document) => document.publication_date === null ? [] : [document.publication_date.slice(0, 4)]))].sort().reverse();
const collections = ['historical_lineage', 'contemporary_eu_ai_policy'].filter((collection) => (
  documents.some((document) => document.temporal_collection === collection)
));
const relevanceClasses = ['direct_ai_substantive', 'ai_related_precursor', 'indirect_adm_legal_context'].filter(
  (relevance) => documents.some((document) => document.relevance_class === relevance),
);
const institutions = [...new Map(
  documents.flatMap((document) => document.institutions.map((institution) => [institution.id, institution])),
).values()].sort((first, second) => first.official_name.localeCompare(second.official_name, 'en-GB'));
const documentTypes = [...new Set(documents.map((document) => document.document_type))].sort();
const legalStatuses = [...new Set(documents.map((document) => document.legal_status))].sort();
const sectors = [...new Set(documents.flatMap((document) => document.sector_tags))].sort();
const provenance = [...new Set(documents.flatMap((document) => document.provenance_tags))].sort();
const policyStages = [...new Set(
  documents.flatMap((document) => document.corpus_assessment === null ? [] : [document.corpus_assessment.policy_stage]),
)].sort();
const concepts = [...new Map(
  documents.flatMap((document) => document.concepts.map((concept) => [concept.id, concept])),
).values()].sort((first, second) => first.name.localeCompare(second.name, 'en-GB'));
const corpusTiers = [...new Set(
  documents.flatMap((document) => document.corpus_assessment === null ? [] : [document.corpus_assessment.corpus_tier]),
)].sort();
const recordLevels = [...new Set(documents.map((document) => document.record_level))].sort();
const versionStatuses = [...new Set(documents.map((document) => document.version_status))].sort();
const policies = [...new Map(
  documents.flatMap((document) => document.policies.map((policy) => [policy.id, policy])),
).values()].sort((first, second) => first.name.localeCompare(second.name, 'en-GB'));

---

<section class="research-section corpus-explorer" aria-labelledby="corpus-heading">
  <div class="section-heading">
    <p class="section-kicker">Published corpus</p>
    <h1 id="corpus-heading">Browse policy documents</h1>
    <p>Search official records and apply research classifications without leaving the page.</p>
  </div>

  <form class="corpus-filters" data-corpus-filters method="get" action={`${base}corpus/`}>
    <div>
      <label for="corpus-view">Corpus view</label>
      <select id="corpus-view" name="view">
        <option value="principal">Principal documents</option>
        <option value="all">All files and versions</option>
      </select>
    </div>
    <div>
      <label for="corpus-query">Search title, CELEX or ELI</label>
      <input id="corpus-query" name="query" type="search" />
    </div>
    <div>
      <label for="corpus-year">Publication year</label>
      <select id="corpus-year" name="year">
        <option value="">All years</option>
        {years.map((year) => <option value={year}>{year}</option>)}
      </select>
    </div>
    <div>
      <label for="corpus-institution">Institution</label>
      <select id="corpus-institution" name="institution">
        <option value="">All institutions</option>
        {institutions.map((institution) => <option value={institution.id}>{institution.official_name}</option>)}
      </select>
    </div>
    <div>
      <label for="corpus-document-type">Document type</label>
      <select id="corpus-document-type" name="documentType">
        <option value="">All document types</option>
        {documentTypes.map((documentType) => <option value={documentType}>{vocabularyLabel(documentType)}</option>)}
      </select>
    </div>
    <div>
      <label for="corpus-legal-status">Legal status</label>
      <select id="corpus-legal-status" name="legalStatus">
        <option value="">All legal statuses</option>
        {legalStatuses.map((legalStatus) => <option value={legalStatus}>{vocabularyLabel(legalStatus)}</option>)}
      </select>
    </div>
    <div>
      <label for="corpus-collection">Collection</label>
      <select id="corpus-collection" name="collection">
        <option value="">All collections and review states</option>
        {collections.map((collection) => <option value={collection}>{vocabularyLabel(collection)}</option>)}
        <option value="legacy_review_pending">Expanded evidence review pending</option>
      </select>
    </div>
    <div>
      <label for="corpus-relevance">Relevance</label>
      <select id="corpus-relevance" name="relevance">
        <option value="">All relevance classes and review states</option>
        {relevanceClasses.map((relevance) => <option value={relevance}>{vocabularyLabel(relevance)}</option>)}
        <option value="legacy_review_pending">Expanded evidence review pending</option>
      </select>
    </div>
    <div>
      <label for="corpus-sector">Sector</label>
      <select id="corpus-sector" name="sector">
        <option value="">All sectors</option>
        {sectors.map((sector) => <option value={sector}>{vocabularyLabel(sector)}</option>)}
      </select>
    </div>
    <div>
      <label for="corpus-provenance">Provenance</label>
      <select id="corpus-provenance" name="provenance">
        <option value="">All provenance types</option>
        {provenance.map((provenance) => <option value={provenance}>{vocabularyLabel(provenance)}</option>)}
      </select>
    </div>
    <div>
      <label for="corpus-policy-stage">Policy stage</label>
      <select id="corpus-policy-stage" name="policyStage">
        <option value="">All policy stages</option>
        {policyStages.map((policyStage) => <option value={policyStage}>{vocabularyLabel(policyStage)}</option>)}
      </select>
    </div>
    <div>
      <label for="corpus-concept">Concept</label>
      <select id="corpus-concept" name="concept">
        <option value="">All concepts</option>
        {concepts.map((concept) => <option value={concept.id}>{concept.name}</option>)}
      </select>
    </div>
    <div>
      <label for="corpus-tier">Corpus tier</label>
      <select id="corpus-tier" name="corpusTier">
        <option value="">All corpus tiers</option>
        {corpusTiers.map((corpusTier) => <option value={corpusTier}>{vocabularyLabel(corpusTier)}</option>)}
      </select>
    </div>
    <div>
      <label for="corpus-record-level">Record level</label>
      <select id="corpus-record-level" name="recordLevel">
        <option value="">All record levels</option>
        {recordLevels.map((recordLevel) => <option value={recordLevel}>{vocabularyLabel(recordLevel)}</option>)}
      </select>
    </div>
    <div>
      <label for="corpus-version-status">Version status</label>
      <select id="corpus-version-status" name="versionStatus">
        <option value="">All version statuses</option>
        {versionStatuses.map((versionStatus) => <option value={versionStatus}>{vocabularyLabel(versionStatus)}</option>)}
      </select>
    </div>
    <div>
      <label for="corpus-policy">Policy process</label>
      <select id="corpus-policy" name="policy">
        <option value="">All policy processes</option>
        {policies.map((policy) => <option value={policy.id}>{policy.name}</option>)}
      </select>
    </div>
    <div class="corpus-filters__actions">
      <button type="submit">Apply filters</button>
      <button type="reset">Reset filters</button>
    </div>
  </form>

  <noscript>
    <p>Interactive filtering requires JavaScript. The complete published corpus is shown below.</p>
  </noscript>
  <p data-corpus-count aria-live="polite">
    {sortedDocuments.length} published records shown · {pendingPublishedCount}/{sortedDocuments.length} shown records pending expanded evidence review
  </p>
  <p data-corpus-total>
    {principalCount} principal documents · {supportingCount} supporting files and versions · {documents.length} published records total
  </p>
  <p data-corpus-empty hidden>No documents match these criteria. Reset filters to view the complete published corpus.</p>
  <ul data-corpus-list>
    {sortedDocuments.map((document) => (
      <li data-document-id={document.id}>
        <a href={`${base}corpus/${document.slug}/`}>{document.short_title}</a>
        <span class="record-summary">
          {' · '}Document date {document.document_date}
          {' · '}{document.publication_date === null ? 'Publication date not yet confirmed' : `Publication date ${document.publication_date}`}
          {' · '}{vocabularyLabel(document.document_type)}
          {' · '}{vocabularyLabel(document.record_level)}
          {' · '}{vocabularyLabel(document.version_status)}
        </span>
        {document.review_qualification && <p class="record-review-qualification">
          {document.review_qualification.confirmed} {document.review_qualification.unresolved}
        </p>}
        <dl class="record-classifications">
          <div>
            <dt>Collection</dt>
            <dd>{vocabularyLabel(document.temporal_collection ?? document.historical_review_status)}</dd>
          </div>
          <div>
            <dt>Relevance</dt>
            <dd>{vocabularyLabel(document.relevance_class ?? document.historical_review_status)}</dd>
          </div>
          <div>
            <dt>Sectors</dt>
            <dd>
              <ul class="tag-list">
                {document.sector_tags.map((sector) => <li>{vocabularyLabel(sector)}</li>)}
              </ul>
            </dd>
          </div>
          <div>
            <dt>Provenance</dt>
            <dd>
              <ul class="tag-list">
                {document.provenance_tags.map((provenance) => <li>{vocabularyLabel(provenance)}</li>)}
              </ul>
            </dd>
          </div>
        </dl>
      </li>
    ))}
  </ul>
</section>

<script id="corpus-documents" type="application/json" set:html={JSON.stringify(documents).replaceAll('<', '\\u003c')}></script>
<script>
  import { buildCorpusSearchParams, filterDocuments, parseCorpusCriteria } from '../lib/filter';
  import type { CorpusCriteria } from '../lib/filter';
  import type { DocumentRecord } from '../lib/types';

  const form = document.querySelector('[data-corpus-filters]');
  const serializedDocuments = document.querySelector('#corpus-documents');
  const count = document.querySelector('[data-corpus-count]');
  const empty = document.querySelector('[data-corpus-empty]');
  const items = [...document.querySelectorAll('[data-document-id]')];

  if (form instanceof HTMLFormElement && serializedDocuments instanceof HTMLScriptElement
    && count instanceof HTMLElement && empty instanceof HTMLElement) {
    const documents: DocumentRecord[] = JSON.parse(serializedDocuments.textContent ?? '[]');

    const readFormCriteria = (): CorpusCriteria => {
      const formData = new FormData(form);
      return parseCorpusCriteria(new URLSearchParams(
        [...formData.entries()]
          .filter(([, value]) => typeof value === 'string')
          .map(([name, value]) => [name, value.toString()]),
      ));
    };

    const applyFilters = (criteria: CorpusCriteria) => {
      const visibleDocuments = filterDocuments(documents, criteria);
      const visibleIds = new Set(visibleDocuments.map((entry) => entry.id));
      const pendingVisible = visibleDocuments.filter(
        (document) => document.historical_review_status === 'legacy_review_pending',
      ).length;

      for (const item of items) {
        if (item instanceof HTMLElement) {
          const documentId = item.dataset.documentId;
          item.hidden = documentId === undefined || !visibleIds.has(documentId);
        }
      }

      const usesAllView = criteria.view === 'all';
      const singular = usesAllView ? 'published record' : 'principal document';
      const plural = usesAllView ? 'published records' : 'principal documents';
      count.textContent = `${visibleIds.size} ${visibleIds.size === 1 ? singular : plural} shown · ${pendingVisible}/${visibleIds.size} shown records pending expanded evidence review`;
      empty.hidden = visibleIds.size !== 0;
    };

    const syncHistory = (criteria: CorpusCriteria, mode: 'push' | 'replace') => {
      const parameters = buildCorpusSearchParams(
        new URLSearchParams(window.location.search),
        criteria,
      );
      const search = parameters.toString();
      const nextUrl = `${window.location.pathname}${search === '' ? '' : `?${search}`}${window.location.hash}`;
      const currentUrl = `${window.location.pathname}${window.location.search}${window.location.hash}`;
      if (nextUrl === currentUrl) return;

      if (mode === 'push') {
        window.history.pushState(window.history.state, '', nextUrl);
      } else {
        window.history.replaceState(window.history.state, '', nextUrl);
      }
    };

    const hydrateControlsFromUrl = (criteria: CorpusCriteria) => {
      for (const control of form.elements) {
        if (control instanceof HTMLInputElement) {
          control.value = control.defaultValue;
        } else if (control instanceof HTMLSelectElement) {
          control.selectedIndex = 0;
        }
      }

      for (const [name, value] of Object.entries(criteria)) {
        const control = form.elements.namedItem(name);
        if (control instanceof HTMLInputElement) {
          control.value = value;
        } else if (control instanceof HTMLSelectElement
          && [...control.options].some((option) => option.value === value)) {
          control.value = value;
        }
      }
    };

    const readUrlAndApplyFilters = () => {
      const criteria = parseCorpusCriteria(new URLSearchParams(window.location.search));
      hydrateControlsFromUrl(criteria);
      applyFilters(readFormCriteria());
    };

    form.addEventListener('input', (event) => {
      if (!(event.target instanceof HTMLInputElement)) return;
      const criteria = readFormCriteria();
      applyFilters(criteria);
      syncHistory(criteria, 'replace');
    });
    form.addEventListener('change', (event) => {
      if (!(event.target instanceof HTMLSelectElement)) return;
      const criteria = readFormCriteria();
      applyFilters(criteria);
      syncHistory(criteria, 'push');
    });
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const criteria = readFormCriteria();
      applyFilters(criteria);
      syncHistory(criteria, 'replace');
    });
    form.addEventListener('reset', () => {
      window.setTimeout(() => {
        const criteria = readFormCriteria();
        applyFilters(criteria);
        syncHistory(criteria, 'push');
      });
    });

    window.addEventListener('popstate', readUrlAndApplyFilters);
    readUrlAndApplyFilters();
  }
</script>
