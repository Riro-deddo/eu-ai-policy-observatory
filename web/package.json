{
  "name": "eu-ai-policy-observatory-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "test": "node --test \"tests/*.test.mjs\" && vitest run",
    "test:e2e": "playwright test",
    "check:public": "python ../scripts/check_public_build.py --site dist --data ../generated/public-data.json"
  },
  "dependencies": {
    "astro": "5.17.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.55.0",
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
